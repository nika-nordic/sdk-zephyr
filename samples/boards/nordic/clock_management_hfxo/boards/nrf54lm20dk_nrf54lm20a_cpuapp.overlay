 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * Models the nRF54LM20B clock tree as devicetree clock producers and binds
 * peripherals (consumers) to it via clock-state nodes. Each clock-state encodes
 * a selection in the tree (a mux input or a gate setting) plus a rank. When a
 * consumer applies a state, the clock-management layer resolves the whole path
 * from the selected node up to its source and arbitrates shared nodes by rank.
 *
 *   Sources        Muxes / gate            Outputs (pclk*)      Consumers
 *   -------        ------------            ---------------      ---------
 *   HFINT ---+
 *            +--> HFCLK (mux) --+--> PCLK32M --> RADIO, PDM, TDM
 *   HFXTAL --+                  +--> PCLK16M --> UARTE
 *      |                        +--> PCLK1M
 *      |                        +--> HCLKCORE -> CPU
 *      +--------> XO24M (gate)--+--> PCLK24M --> USBHS, PDM
 *   LFRC ----+
 *            +--> LFCLK (mux) --+--> PCLK32Ki -> GRTC
 *   LFXTAL --+   (SYNT from HFCLK)
 */

#include "clock_ids.h"

/ {
	clocks {
		/* Internal always-on sources. */
		hfint: hfint {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <DT_FREQ_M(128)>;
		};

		lfrc: lfrc {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32768>;
		};

		/* HFXTAL (&hfxo) and LFXTAL (&lfxo) come from the SoC devicetree. */

		/* HFCLK: mux(HFINT, HFXTAL). Feeds PCLK32M/16M/1M and HCLKCORE. */
		hfclk: hfclk {
			compatible = "clock-mux";
			#clock-cells = <1>;
			mgmt-id = <CLK_ID_HFCLK>;
			input-sources = <&hfint &hfxo>;
			clock-frequency = <DT_FREQ_M(128)>;
		};

		/* XO24M: gate derived from HFXTAL. Feeds PCLK24M. */
		xo24m_gate: xo24m-gate {
			compatible = "clock-gate";
			#clock-cells = <1>;
			mgmt-id = <CLK_ID_XO24M>;
			input = <&hfxo>;
			clock-frequency = <DT_FREQ_M(24)>;
		};

		/* LFCLK: mux(LFRC, LFXTAL). Feeds PCLK32Ki. */
		lfclk_mux: lfclk-mux {
			compatible = "clock-mux";
			#clock-cells = <1>;
			mgmt-id = <CLK_ID_LFCLK>;
			input-sources = <&lfrc &lfxo>;
			clock-frequency = <32768>;
		};
	};

	/* Selectable configurations (like pinctrl states), grouped for clarity. */
	clock-states {
		/* UARTE on PCLK16M: prefers HFXO, tolerates HFINT. */
		uarte_xtal: uarte-xtal {
			compatible = "clock-state";
			clocks = <&hfclk HFCLK_SRC_HFXO>;
			clock-frequency = <DT_FREQ_M(16)>;
			rank = <0>;
		};
		uarte_hfint: uarte-hfint {
			compatible = "clock-state";
			clocks = <&hfclk HFCLK_SRC_HFINT>;
			clock-frequency = <DT_FREQ_M(16)>;
			rank = <10>;
		};

		/* RADIO on PCLK32M: requires HFXO. */
		radio_xtal: radio-xtal {
			compatible = "clock-state";
			clocks = <&hfclk HFCLK_SRC_HFXO>;
			clock-frequency = <DT_FREQ_M(32)>;
			rank = <0>;
		};

		/* TDM on PCLK32M: default (HFINT) is fine. */
		tdm_default: tdm-default {
			compatible = "clock-state";
			clocks = <&hfclk HFCLK_SRC_HFINT>;
			clock-frequency = <DT_FREQ_M(32)>;
			rank = <10>;
		};

		/* PDM: best on PCLK24M (XO24M), else PCLK32M xtal, else HFINT. */
		pdm_24m: pdm-24m {
			compatible = "clock-state";
			clocks = <&xo24m_gate XO24M_ON>;
			clock-frequency = <DT_FREQ_M(24)>;
			rank = <0>;
		};
		pdm_32m_xtal: pdm-32m-xtal {
			compatible = "clock-state";
			clocks = <&hfclk HFCLK_SRC_HFXO>;
			clock-frequency = <DT_FREQ_M(32)>;
			rank = <5>;
		};
		pdm_32m_default: pdm-32m-default {
			compatible = "clock-state";
			clocks = <&hfclk HFCLK_SRC_HFINT>;
			clock-frequency = <DT_FREQ_M(32)>;
			rank = <10>;
		};

		/* USBHS on PCLK24M: requires XO24M. */
		usbhs_24m: usbhs-24m {
			compatible = "clock-state";
			clocks = <&xo24m_gate XO24M_ON>;
			clock-frequency = <DT_FREQ_M(24)>;
			rank = <0>;
		};

		/* GRTC on PCLK32Ki: prefers LFXTAL, tolerates LFRC. */
		grtc_lfxo: grtc-lfxo {
			compatible = "clock-state";
			clocks = <&lfclk_mux LFCLK_SRC_LFXO>;
			clock-frequency = <32768>;
			rank = <0>;
		};
		grtc_lfrc: grtc-lfrc {
			compatible = "clock-state";
			clocks = <&lfclk_mux LFCLK_SRC_LFRC>;
			clock-frequency = <32768>;
			rank = <10>;
		};
	};

	/* Consumers: peripherals bound to clock-states. */
	clock-consumers {
		uarte_consumer: uarte {
			compatible = "zephyr,clock-consumer-demo";
			clock-state-0 = <&uarte_xtal>;
			clock-state-1 = <&uarte_hfint>;
			clock-state-names = "xtal", "hfint";
		};

		radio_consumer: radio {
			compatible = "zephyr,clock-consumer-demo";
			clock-state-0 = <&radio_xtal>;
			clock-state-names = "xtal";
		};

		tdm_consumer: tdm {
			compatible = "zephyr,clock-consumer-demo";
			clock-state-0 = <&tdm_default>;
			clock-state-names = "default";
		};

		pdm_consumer: pdm {
			compatible = "zephyr,clock-consumer-demo";
			clock-state-0 = <&pdm_24m>;
			clock-state-1 = <&pdm_32m_xtal>;
			clock-state-2 = <&pdm_32m_default>;
			clock-state-names = "24m", "32m-xtal", "32m-default";
		};

		usbhs_consumer: usbhs {
			compatible = "zephyr,clock-consumer-demo";
			clock-state-0 = <&usbhs_24m>;
			clock-state-names = "24m";
		};

		grtc_consumer: grtc {
			compatible = "zephyr,clock-consumer-demo";
			clock-state-0 = <&grtc_lfxo>;
			clock-state-1 = <&grtc_lfrc>;
			clock-state-names = "lfxo", "lfrc";
		};
	};
};
