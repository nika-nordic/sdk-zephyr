 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * Models the nRF54LM20B clock tree as devicetree clock producers, wires the
 * relevant peripherals (consumers) to the producer signals they consume, and
 * describes the selectable configurations as clock-state nodes carrying a rank.
 *
 * Everything here is local to this sample. The three producers that can be
 * driven at runtime (HFXO, XO24M, LFCLK) map to the existing split clock_control
 * devices &xo, &xo24m and &lfclk; the rest of the tree is descriptive.
 *
 *   Sources        Muxes / derived           Outputs (pclk*)      Consumers
 *   -------        ---------------           ---------------      ---------
 *   HFINT ---+
 *            +--> HFCLK (mux) --+--> PCLK32M --> RADIO, PDM, TDM
 *   HFXTAL --+                  +--> PCLK16M --> UARTE
 *      |                        +--> PCLK1M
 *      |                        +--> HCLKCORE -> CPU
 *      +--------> XO24M --------+--> PCLK24M --> USBHS, PDM
 *   LFRC ----+
 *            +--> LFCLK (mux) --+--> PCLK32Ki -> GRTC
 *   LFXTAL --+   (SYNT from HFCLK)
 */

/*
 * The runtime-controllable producers. Give them #clock-cells so they can be the
 * target of a clock-state `clocks` phandle and be resolved to a struct device.
 */
&xo {
	#clock-cells = <0>;
};

&xo24m {
	#clock-cells = <0>;
};

&lfclk {
	#clock-cells = <0>;
};

/ {
	clocks {
		/* --- Internal always-on sources (no runtime action needed) --- */
		hfint: hfint {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <DT_FREQ_M(128)>;
		};

		lfrc: lfrc {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32768>;
		};

		/* HFXTAL (&hfxo) and LFXTAL (&lfxo) come from the SoC devicetree. */

		/* --- HFCLK: mux(HFINT, HFXTAL) and its peripheral outputs --- */
		hfclk: hfclk {
			compatible = "clock-mux";
			#clock-cells = <1>;
			input-sources = <&hfint &hfxo>;
			clock-frequency = <DT_FREQ_M(128)>;

			pclk32m_clk: pclk32m {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <DT_FREQ_M(32)>;

				pclk32m_out: clock-output {
					compatible = "clock-output";
					#clock-cells = <0>;

					pclk32m_xtal: clock-state-xtal {
						compatible = "clock-state";
						clocks = <&xo>;
						clock-frequency = <DT_FREQ_M(32)>;
						rank = <5>;
					};

					pclk32m_default: clock-state-default {
						compatible = "clock-state";
						clock-frequency = <DT_FREQ_M(32)>;
						rank = <10>;
					};
				};
			};

			pclk16m_clk: pclk16m {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <DT_FREQ_M(16)>;

				pclk16m_out: clock-output {
					compatible = "clock-output";
					#clock-cells = <0>;

					pclk16m_xtal: clock-state-xtal {
						compatible = "clock-state";
						clocks = <&xo>;
						clock-frequency = <DT_FREQ_M(16)>;
						rank = <0>;
					};

					pclk16m_default: clock-state-default {
						compatible = "clock-state";
						clock-frequency = <DT_FREQ_M(16)>;
						rank = <10>;
					};
				};
			};

			pclk1m_clk: pclk1m {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <DT_FREQ_M(1)>;

				pclk1m_out: clock-output {
					compatible = "clock-output";
					#clock-cells = <0>;
				};
			};

			hclkcore_clk: hclkcore {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <DT_FREQ_M(128)>;

				hclkcore_out: clock-output {
					compatible = "clock-output";
					#clock-cells = <0>;

					hclkcore_default: clock-state-default {
						compatible = "clock-state";
						clock-frequency = <DT_FREQ_M(128)>;
						rank = <0>;
					};
				};
			};
		};

		/* --- XO24M: derived from HFXTAL --- */
		xo24m_clk: xo24m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <DT_FREQ_M(24)>;

			pclk24m_clk: pclk24m {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <DT_FREQ_M(24)>;

				pclk24m_out: clock-output {
					compatible = "clock-output";
					#clock-cells = <0>;

					pclk24m_xtal: clock-state-xtal {
						compatible = "clock-state";
						clocks = <&xo24m>;
						clock-frequency = <DT_FREQ_M(24)>;
						rank = <0>;
					};
				};
			};
		};

		/* --- LFCLK: mux(LFRC, LFXTAL, SYNT-from-HFCLK) --- */
		lfclk_mux: lfclk-mux {
			compatible = "clock-mux";
			#clock-cells = <1>;
			input-sources = <&lfrc &lfxo &hfclk>;
			clock-frequency = <32768>;

			pclk32ki_clk: pclk32ki {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <32768>;

				pclk32ki_out: clock-output {
					compatible = "clock-output";
					#clock-cells = <0>;

					pclk32ki_xtal: clock-state-xtal {
						compatible = "clock-state";
						clocks = <&lfclk>;
						clock-frequency = <32768>;
						rank = <0>;
					};

					pclk32ki_rc: clock-state-rc {
						compatible = "clock-state";
						clock-frequency = <32768>;
						rank = <10>;
					};
				};
			};
		};
	};

	/* --- Consumers: peripherals bound to producer signals via clock-states --- */
	clock-consumers {
		uarte_consumer: uarte {
			compatible = "zephyr,clock-consumer-demo";
			clock-outputs = <&pclk16m_out>;
			clock-output-names = "pclk16m";
			clock-state-0 = <&pclk16m_xtal>;
			clock-state-1 = <&pclk16m_default>;
			clock-state-names = "xtal", "default";
		};

		radio_consumer: radio {
			compatible = "zephyr,clock-consumer-demo";
			clock-outputs = <&pclk32m_out>;
			clock-output-names = "pclk32m";
			clock-state-0 = <&pclk32m_xtal>;
			clock-state-names = "xtal";
		};

		tdm_consumer: tdm {
			compatible = "zephyr,clock-consumer-demo";
			clock-outputs = <&pclk32m_out>;
			clock-output-names = "pclk32m";
			clock-state-0 = <&pclk32m_default>;
			clock-state-names = "default";
		};

		pdm_consumer: pdm {
			compatible = "zephyr,clock-consumer-demo";
			clock-outputs = <&pclk24m_out>, <&pclk32m_out>;
			clock-output-names = "pclk24m", "pclk32m";
			clock-state-0 = <&pclk24m_xtal>;
			clock-state-1 = <&pclk32m_xtal>;
			clock-state-2 = <&pclk32m_default>;
			clock-state-names = "pclk24m-xtal", "pclk32m-xtal", "pclk32m-default";
		};

		usbhs_consumer: usbhs {
			compatible = "zephyr,clock-consumer-demo";
			clock-outputs = <&pclk24m_out>;
			clock-output-names = "pclk24m";
			clock-state-0 = <&pclk24m_xtal>;
			clock-state-names = "xtal";
		};

		grtc_consumer: grtc {
			compatible = "zephyr,clock-consumer-demo";
			clock-outputs = <&pclk32ki_out>;
			clock-output-names = "pclk32ki";
			clock-state-0 = <&pclk32ki_xtal>;
			clock-state-1 = <&pclk32ki_rc>;
			clock-state-names = "xtal", "rc";
		};

		cpu_consumer: cpu {
			compatible = "zephyr,clock-consumer-demo";
			clock-outputs = <&hclkcore_out>;
			clock-output-names = "hclkcore";
			clock-state-0 = <&hclkcore_default>;
			clock-state-names = "default";
		};
	};
};
